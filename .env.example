# =============================================================
# Agentic Conversion & Merchant Growth Engine
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# =============================================================

# --- LLM (Google AI Studio) ---
GEMINI_API_KEY=paste-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Razorpay sandbox ---
RAZORPAY_KEY_ID=paste-your-razorpay-key-id
RAZORPAY_KEY_SECRET=paste-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret

# --- Postgres (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=growth_engine
# Used by the backend container to reach the postgres service
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growth_engine

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Session behaviour ---
SESSION_TTL_SECONDS=1800
MAX_GUARDRAIL_RETRIES=3
MAX_NEGOTIATION_TURNS=3
MERCHANT_ID=merchant_demo
